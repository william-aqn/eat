{
  "name": "eat-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k -n vite,wrangler \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.4",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.125.0"
  }
}
