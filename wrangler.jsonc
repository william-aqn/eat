{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eat-diary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*"]
  },
  "vars": {
    // Публичный идентификатор OAuth-клиента (не секрет). Замените на свой из Google Cloud Console.
    "GOOGLE_CLIENT_ID": "REPLACE_ME.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
  // Секреты (не хранятся в этом файле):
  //   wrangler secret put GOOGLE_CLIENT_SECRET
  //   wrangler secret put COOKIE_KEY        (base64 от 32 случайных байт)
  // Для локальной разработки — файл .dev.vars (см. .dev.vars.example)
}
